{
  "version": 1,
  "updated": "simple-fake-mobile",
  "socks_port": 10800,
  "default_ttl": 64,
  "direct_ru": true,
  "quic_fallback": true,
  "defaults": {
    "tcp": ["fake-tls", "fake-tls-4pda", "direct"],
    "udp": ["quic-fake", "direct"]
  },
  "rules": [
    { "hosts": ["4pda.to"], "strategy": "fake-tls-4pda" }
  ],
  "strategies": [
    { "id": "fake-tls", "cost": 1, "tcp": { "actions": [ { "type": "fake", "pos": "sni_end", "ttl_range": [2, 6], "payload": "tls_google" } ] } },
    { "id": "fake-tls-4pda", "cost": 2, "tcp": { "actions": [ { "type": "fake", "pos": "sni_end", "ttl_range": [2, 6], "payload": "tls_4pda" } ] } },
    { "id": "split-1", "cost": 3, "tcp": { "actions": [ { "type": "split", "pos": "1" } ] } },
    { "id": "quic-fake", "cost": 1, "udp": { "fake": { "count": 6, "ttl": 8, "payload": "quic_google" } } },
    { "id": "direct", "cost": 99, "action": "direct" }
  ]
}
